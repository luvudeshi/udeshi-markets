class Side(enum.Enum):
    BUY = 0
    SELL = 1

class OrderType(enum.Enum):
    LIMIT = 0
    MARKET = 1

class TimeInForce(enum.Enum):
    GOOD_TILL_CANCEL = 0
    IMMEDIATE_OR_CANCEL = 1

class SelfTradePrevention(enum.Enum):
    ALLOW = 0
    CANCEL_RESTING = 1
    CANCEL_INCOMING = 2

class OrderStatus(enum.Enum):
    REJECTED = 0
    RESTING = 1
    FILLED = 2
    CANCELLED = 3

class RejectReason(enum.Enum):
    NONE = 0
    UNKNOWN_INSTRUMENT = 1
    INVALID_SIDE = 2
    INVALID_ORDER_TYPE = 3
    INVALID_TIME_IN_FORCE = 4
    INVALID_SELF_TRADE_PREVENTION = 5
    INVALID_QUANTITY = 6
    INVALID_PRICE = 7
    MARKET_ORDER_WITH_PRICE = 8

class CancelReason(enum.Enum):
    NONE = 0
    USER_REQUESTED = 1
    NO_LIQUIDITY = 2
    SELF_TRADE_PREVENTION = 3

class CancelOutcome(enum.Enum):
    CANCELLED = 0
    UNKNOWN_INSTRUMENT = 1
    ORDER_NOT_FOUND = 2

